{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "package.json",
      "package-lock.json"
    ],
    "redirects": [
      { "source": "/career-opportunities.html", "destination": "/forms/careers.html", "type": 301 },
      { "source": "/career.html", "destination": "/forms/careers.html", "type": 301 },
      { "source": "/subcontractor-empanelment.html", "destination": "/forms/subcontractor.html", "type": 301 },
      { "source": "/vendor-registration.html", "destination": "/forms/vendor.html", "type": 301 },
      { "source": "/strategic-partnerships.html", "destination": "/forms/partnership.html", "type": 301 },
      { "source": "/joint-ventures.html", "destination": "/forms/joint-venture.html", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "/api/config",
        "function": "api"
      },
      {
        "source": "/api/forms",
        "function": "api"
      },
      {
        "source": "/api/submit",
        "function": "submitForm"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|svg|png|jpg|jpeg|gif|ico|webp|woff|woff2|ttf|eot|otf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "js/firebase/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "js/firebase-submit.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      }
    ],
    "appAssociation": "AUTO",
    "cleanUrls": true,
    "trailingSlash": false
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "functions": {
      "port": 5001,
      "host": "127.0.0.1"
    },
    "hosting": {
      "port": 5000,
      "host": "127.0.0.1"
    },
    "firestore": {
      "port": 8080,
      "host": "127.0.0.1"
    },
    "storage": {
      "port": 9199,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": true,
      "port": 4000,
      "host": "127.0.0.1"
    }
  }
}

