# ----- Email transport (used by Firebase function / Cloudflare worker) -----
# Gmail SMTP (simplest path to deliver to aaraainfrastructure@gmail.com):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sender@gmail.com         # the Gmail account that SENDS the mail
SMTP_PASS=xxxxxxxxxxxxxxxx               # 16-char Gmail APP PASSWORD (NOT your login password)

# Where submissions are delivered:
MAIL_FROM=AARAA Website <your-sender@gmail.com>
MAIL_TO=aaraainfrastructure@gmail.com

# CORS: comma-separated list of allowed site origins (or * for any)
ALLOWED_ORIGINS=https://www.aaraainfrastructure.com,https://aaraainfrastructure.com

# ----- Optional: Google reCAPTCHA v3 (anti-spam) -----
RECAPTCHA_SECRET=

# ----- Optional: transactional provider alternatives (better deliverability) -----
# Use ONE of these instead of Gmail SMTP if you prefer:
# RESEND_API_KEY=
# SENDGRID_API_KEY=
